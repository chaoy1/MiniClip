<Window x:Class="MiniClip.UI.ClearHistoryConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认清空历史"
        Width="300"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ChromeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ChromeFieldBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ChromeBorderBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonShell" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonShell" Property="BorderBrush" Value="{DynamicResource ChromeTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="Transparent">
        <Border x:Name="Shell" CornerRadius="10" BorderThickness="1"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                Background="{DynamicResource ChromeSurfaceBrush}">
            <StackPanel Margin="18,16,18,16">
                <TextBlock x:Name="TitleText"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeTextBrush}" />
                <TextBlock Text="清空后无法从 MiniClip 恢复。当前系统剪贴板不会改变。"
                           TextWrapping="Wrap" LineHeight="17"
                           Margin="0,7,0,16" FontSize="11"
                           Foreground="{DynamicResource ChromeMutedBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" IsDefault="True" IsCancel="True"
                            Style="{StaticResource ActionButton}" Click="OnCancelClick" />
                    <Button x:Name="ClearButton" Content="清空" Margin="7,0,0,0"
                            Style="{StaticResource ActionButton}"
                            Background="{DynamicResource ChromePrimaryBrush}"
                            Foreground="{DynamicResource ChromePrimaryTextBrush}"
                            BorderBrush="{DynamicResource ChromePrimaryBrush}"
                            Click="OnClearClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
