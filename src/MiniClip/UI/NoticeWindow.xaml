<Window x:Class="MiniClip.UI.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniClip 提示"
        Width="252"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">

    <Grid Background="Transparent">
        <Border x:Name="Shell"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{DynamicResource ChromeBorderBrush}"
                Background="{DynamicResource ChromeSurfaceBrush}">
            <StackPanel Margin="12,10,12,10">
                <TextBlock x:Name="TitleText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText"
                           Margin="0,4,0,0"
                           FontSize="11"
                           LineHeight="16"
                           Foreground="{DynamicResource ChromeMutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
