<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        MiniClip design tokens.

        Legacy chrome tokens for the hotkey settings dialog and icon. The popup has
        its own neutral palettes in PopupThemePalette.cs; see docs/DESIGN.md.
    -->

    <!-- ============================================================ colour: dark -->
    <Color x:Key="Ink900Color">#FF0F141B</Color>
    <Color x:Key="Ink850Color">#FF121925</Color>
    <Color x:Key="Ink700Color">#FF2C3A4C</Color>
    <Color x:Key="Paper050Color">#FFE7EDF4</Color>
    <Color x:Key="Paper500Color">#FF94A5BA</Color>
    <Color x:Key="Signal500Color">#FF6FD3B4</Color>
    <Color x:Key="Caution450Color">#FFE0A94A</Color>
    <Color x:Key="Danger450Color">#FFE8826B</Color>

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Ink900Color}" />
    <SolidColorBrush x:Key="SurfaceWashBrush" Color="{StaticResource Ink850Color}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource Ink700Color}" />
    <SolidColorBrush x:Key="HairlineSoftBrush" Color="#1AE7EDF4" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Paper050Color}" />
    <SolidColorBrush x:Key="TextChromeBrush" Color="{StaticResource Paper500Color}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Signal500Color}" />
    <SolidColorBrush x:Key="AccentWashBrush" Color="#1A6FD3B4" />
    <SolidColorBrush x:Key="AccentStrokeBrush" Color="#6B6FD3B4" />
    <SolidColorBrush x:Key="CautionBrush" Color="{StaticResource Caution450Color}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger450Color}" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#8C070A0F" />

    <!-- ============================================================= typography -->
    <!--
        Two stacks on a functional line, and the split is the product's hierarchy:
        content wears the monospace, chrome wears the system UI face.

        Cascadia *Mono*, not Cascadia Code: the mono cut has no programming ligatures,
        so != and -> render as the literal characters the user copied. A clipboard must
        never display a character that is not in the payload.

        Microsoft YaHei UI is written into BOTH stacks. Cascadia Mono has no CJK
        coverage; without this the OS picks a face by GDI font linking and 暂无文本记录
        breaks weight and vertical metrics against the Latin text next to it.
    -->
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI, monospace</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>

    <sys:Double x:Key="FontSizeContent">13</sys:Double>
    <sys:Double x:Key="FontSizeChrome">12</sys:Double>
    <sys:Double x:Key="LineHeightContent">20</sys:Double>
    <sys:Double x:Key="LineHeightChrome">16</sys:Double>

    <!-- ================================================================ geometry -->
    <sys:Double x:Key="PopupWidth">400</sys:Double>
    <sys:Double x:Key="RowHeight">40</sys:Double>
    <sys:Double x:Key="ListPaddingVertical">10</sys:Double>
    <sys:Double x:Key="GutterWidth">14</sys:Double>
    <sys:Double x:Key="RightColumnWidth">24</sys:Double>
    <sys:Double x:Key="FooterMinHeight">26</sys:Double>
    <CornerRadius x:Key="PopupCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="MenuCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="KeyCornerRadius">4</CornerRadius>

    <!-- ================================================================== motion -->
    <!--
        The panel must feel like it was already there, not like it flew in: 90 ms of
        opacity plus a 2 DIP settle. One orchestrated moment, nothing else animates.
        All of it is skipped when Windows is set to reduce animations (checked in code,
        because WPF's own SystemParameters answer is not reliable enough to rely on).
    -->
    <Duration x:Key="AppearDuration">0:0:0.09</Duration>
    <Duration x:Key="DismissDuration">0:0:0.07</Duration>
    <Duration x:Key="RowDuration">0:0:0.07</Duration>
    <Duration x:Key="ConfirmDuration">0:0:0.16</Duration>
    <CubicEase x:Key="StandardEase" EasingMode="EaseOut" />

</ResourceDictionary>
